# Get a key at https://sosovalue.com/developer/dashboard (SoSoValue Open API). Approval can take days.
# Never commit the real .env; it is git-ignored.
SOSOVALUE_API_KEY=
# Optional. Only if you get HTTP 401 with an approved key: the docs name the header x-soso-api-key
# (OpenAPI, curl examples) but one error example says X-API-KEY.
# SOSOVALUE_KEY_HEADER=X-API-KEY
